meta {
  name: Login Ana
  type: http
  seq: 1
}

post {
  url: {{host}}/login
  body: json
  auth: none
}

headers {
  Accept: application/json
}

body:json {
  {
    "email": "ana@taskboard.test",
    "password": "password123",
    "dispositivo": "bruno-casos-limite"
  }
}

script:post-response {
  bru.setVar("tokenAna", res.getBody().token);
}

tests {
  test("Login responde 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
}

docs {
  Primera petición de la colección: sin ella, todas las demás responden 401.

  Guarda el token en {{tokenAna}}, que la colección usa como Bearer. El nombre del
  dispositivo deja la sesión identificada en GET /api/tokens.
}
