meta {
  name: Borrar la transacción de CL-01
  type: http
  seq: 1
}

delete {
  url: {{host}}/transacciones/{{idCL01}}
  body: none
  auth: inherit
}

headers {
  Accept: application/json
}

tests {
  test("Limpieza CL-01 responde 204", function () {
    expect(res.getStatus()).to.equal(204);
  });
}

docs {
  Borra la transacción que creó CL-01, usando el id que esa petición guardó en
  {{idCL01}}.

  No es un caso límite: es higiene. Sin esta carpeta, cada corrida de la colección
  dejaría cuatro filas nuevas en la base y los conteos del experimento de
  integridad se irían moviendo entre una corrida y la siguiente.
}
